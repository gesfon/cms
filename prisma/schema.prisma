generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name 	    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Posts {
  id        Int    @id @default(autoincrement())
  title 	  String
  excerpt	  String
  content 	String
  image 	  String
  user 	    String
  category  String
  createdAt DateTime @default(now())
}
